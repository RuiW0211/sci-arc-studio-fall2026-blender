# --- never public: copyrighted references and imagery-based checks ---
site-model/references/
site-model/checks/

# --- large or regenerable ---
# USGS LAZ tiles (67 MB+); download with the URL in CLAUDE.md
site-model/data/lidar/
# Blender files are binary and unmergeable; they are rebuilt by the build_*.py scripts
*.blend
*.blend1
*.blend@
# Houdini: scenes are local work (like .blend; binary, unmergeable). The scripts (tools/, vex/), the building
# entities (annotations/) and the hand-off (handoff/) are committed; raw downloads, the 6.8 GB staging, the outputs
# and their backups are regenerated by tools/
*.hip
*.hipnc
*.hiplc
site-model/houdini/in/
site-model/houdini/work/
site-model/houdini/out/
site-model/houdini/tools/node_modules/
site-model/houdini/annotations/*_backup.json

# experiment outputs (meshes, renders) are regenerated by the scripts next to them
site-model/experiments/out/

# --- tooling ---
__pycache__/
*.pyc
.venv/
.DS_Store
Thumbs.db
desktop.ini
